# Optional: for running `docker compose` directly (run-server.ps1 sets these
# from config.ini automatically, so you only need this file for manual use).
# Copy to .env and edit.

ASR_ENGINE=parakeet
# ASR_MODEL=nemo-parakeet-tdt-0.6b-v2
ASR_DEVICE=auto
ASR_QUANTIZATION=none
ASR_PORT=9000
ASR_IMAGE=vdi-dictate-asr:latest

# GPU build (default). For a CPU-only machine use: ORT_PACKAGE=onnxruntime
ORT_PACKAGE=onnxruntime-gpu
# Set true to bake in torch + transformers (enables engine = hf:<repo/id>)
INSTALL_HF=false

# engine = openai only:
# ASR_UPSTREAM_URL=https://api.example.com
# ASR_UPSTREAM_KEY=sk-...
